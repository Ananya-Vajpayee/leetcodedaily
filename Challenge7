https://leetcode.com/problems/stone-game-viii/
class Solution:
    def stoneGameVIII(self, stones: List[int]) -> int:
        for i in range(1, len(stones)):
            stones[i] += stones[i - 1]

        dp = stones[-1]

        for i in range(len(stones) - 2, 0, -1):
            dp = max(dp, stones[i] - dp)

        return dp
