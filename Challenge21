https://leetcode.com/problems/distinct-subsequences-ii/description/

class Solution:
    def distinctSubseqII(self, s: str) -> int:
        MOD = 10**9 + 7
        dp = 1  # counts the empty subsequence
        last = {}
        
        for c in s:
            new_dp = (2 * dp - last.get(c, 0)) % MOD
            last[c] = dp
            dp = new_dp
        
        return (dp - 1) % MOD  # subtract the empty subsequence
