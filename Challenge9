https://leetcode.com/problems/shortest-and-lexicographically-smallest-beautiful-string/
class Solution:
    def shortestBeautifulSubstring(self, s: str, k: int) -> str:
        n = len(s)
        best = ""
        left = 0
        ones = 0
        
        for right in range(n):
            if s[right] == '1':
                ones += 1
            
            # If we have too many ones, shrink from the left
            while ones > k:
                if s[left] == '1':
                    ones -= 1
                left += 1
            
            # If we have exactly k ones, try to shrink further and record candidates
            while ones == k:
                candidate = s[left:right + 1]
                if best == "" or len(candidate) < len(best) or \
                   (len(candidate) == len(best) and candidate < best):
                    best = candidate
                
                if s[left] == '1':
                    ones -= 1
                left += 1
        
        return best
