https://leetcode.com/problems/sum-game/
class Solution:
    def sumGame(self, num: str) -> bool:
        n = len(num)
        half = n // 2
        s1 = s2 = cnt1 = cnt2 = 0

        for c in num[:half]:
            if c == '?':
                cnt1 += 1
            else:
                s1 += int(c)

        for c in num[half:]:
            if c == '?':
                cnt2 += 1
            else:
                s2 += int(c)

        return (cnt1 + cnt2) % 2 == 1 or s1 - s2 != 9 * (cnt2 - cnt1) // 2
